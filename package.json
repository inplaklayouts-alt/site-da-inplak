{
  "name": "inplak-site",
  "version": "2.0.0",
  "private": true,
  "description": "Site da Inplak Comunicação Visual (estático, sem dependências).",
  "type": "module",
  "scripts": {
    "images": "python -P scripts/images.py",
    "build": "node scripts/build.mjs --target=github",
    "build:github-pages": "node scripts/build.mjs --target=github --site-url=https://inplaklayouts-alt.github.io/site-da-inplak",
    "build:hostinger": "node scripts/build.mjs --target=hostinger",
    "test": "node scripts/test-apps-script.mjs",
    "dev": "node scripts/build.mjs --target=github && node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
