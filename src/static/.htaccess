# =========================================================
# Inplak Comunicação Visual — configuração do servidor
# (Hostinger / LiteSpeed, compatível com Apache)
# =========================================================

Options -Indexes -MultiViews
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

AddType image/avif .avif
AddType image/webp .webp
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
RewriteEngine On

# --- HTTPS e domínio sem "www" ---
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

# --- Arquivos ocultos (exceto .well-known, usado pelo certificado SSL) ---
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# --- Endereços do site antigo (WordPress) -> páginas novas ---
RewriteCond %{QUERY_STRING} (^|&)post_type=inplak-projetos(&|$) [NC]
RewriteRule ^$ /projetos/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id|cat|author|s|m|attachment_id)= [NC]
RewriteRule ^$ /? [R=301,L]

RewriteRule ^projetos/comunicacao-visual-interna-\d+/?$ /projetos/?categoria=interna [R=301,L]
RewriteRule ^projetos/fachadas-\d+/?$ /projetos/?categoria=fachadas [R=301,L]
RewriteRule ^projetos/totens-e-letreiros-\d+/?$ /projetos/?categoria=totens [R=301,L]
RewriteRule ^projetos/expositores-comerciais-\d+/?$ /projetos/?categoria=mobiliario [R=301,L]
RewriteRule ^projetos/construcao-civil-\d+/?$ /projetos/?categoria=estrutura [R=301,L]

RewriteRule ^categoria-projeto/comunicacao-visual-interna/?$ /projetos/?categoria=interna [R=301,L]
RewriteRule ^categoria-projeto/comunicacao-visual-externa(-comunicacao-visual-externa)?/?$ /projetos/?categoria=fachadas [R=301,L]
RewriteRule ^categoria-projeto/expositores-comerciais/?$ /projetos/?categoria=mobiliario [R=301,L]
RewriteRule ^categoria-projeto/totens/?$ /projetos/?categoria=totens [R=301,L]
RewriteRule ^categoria-projeto(/.*)?$ /projetos/ [R=301,L]

RewriteRule ^cases/fachada-institucional-de-alto-impacto/?$ /servicos/comunicacao-visual-interna/ [R=301,L]
RewriteRule ^cases/estrutura-metalica-para-construcao-civil/?$ /servicos/comunicacao-visual-externa/ [R=301,L]
RewriteRule ^cases/ambientacao-visual-para-supermercado-premium/?$ /servicos/mobiliario-e-marcenaria/ [R=301,L]

RewriteRule ^(wp-sitemap.*|sitemap_index)\.xml$ /sitemap.xml [R=301,L]

# --- Páginas e arquivos do WordPress que não existem mais (410 = removido) ---
RewriteRule ^(hello-world|category|author|tag|feed|comments|wp-json|wp-admin|wp-content|wp-includes)(/.*)?$ - [G,L]
RewriteRule ^(wp-login|xmlrpc|wp-cron|wp-config|wp-signup|wp-trackback|wp-comments-post|wp-load|wp-settings)\.php$ - [G,L]
RewriteRule ^(readme\.html|license\.txt)$ - [G,L]
</IfModule>

# --- Segurança ---
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
Header always set Cross-Origin-Opener-Policy "same-origin"
Header always set Content-Security-Policy "__CSP__"
Header always unset X-Powered-By
Header unset X-Powered-By

# Cache: CSS e JS levam versão no endereço (?v=...), por isso podem ficar 1 ano no navegador.
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(avif|webp|png|jpe?g|ico|svg)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 hour"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/javascript "access plus 1 year"
ExpiresByType image/avif "access plus 1 month"
ExpiresByType image/webp "access plus 1 month"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/x-icon "access plus 1 month"
ExpiresByType application/manifest+json "access plus 1 week"
ExpiresByType application/xml "access plus 1 day"
ExpiresByType text/xml "access plus 1 day"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>
